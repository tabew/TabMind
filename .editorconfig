root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,hpp,h,c}]
indent_size = 4

[*.{json,yml,yaml,vcxproj,filters}]
indent_size = 4

[*.py]
indent_size = 4

[*.{bat,cmd}]
# Windows 批处理保持 CRLF，避免 cmd 解析异常
end_of_line = crlf
indent_size = 4
